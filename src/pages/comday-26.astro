---
import Layout from "../layouts/Layout.astro";
import { ComDayHero } from "../components/community-day/ComDayHero";
import { ComDaySectionNav } from "../components/community-day/ComDaySectionNav";
import { MetricsBar } from "../components/community-day/MetricsBar";
import { CFPSection } from "../components/community-day/CFPSection";
import { SponsorSection } from "../components/community-day/SponsorSection";
import { ComDaySponsors } from "../components/community-day/ComDaySponsors";
import { MobileStickyBar } from "../components/community-day/MobileStickyBar";
import { PretixWidget } from "../components/PretixWidget";
import { EventFAQ } from "../components/EventFAQ";
import AgendaStatus from "@/components/AgendaStatus";
import { VolunteerCallSection } from "../components/community-day/VolunteerCallSection";
import PeopleList from "../components/people/PeopleList";
import { getCollection } from "astro:content";
import { buildPeopleGroups } from "@/lib/event-people";
import { comday26Faqs } from "@/data/faqs";

const comdayEvent = (await getCollection("events")).find(
    (entry) => entry.id === "community-day-2026"
);
const peopleGroups = comdayEvent
    ? buildPeopleGroups(comdayEvent.data.organizers, comdayEvent.data.volunteers)
    : [];
const kioskUrl = import.meta.env.PUBLIC_IMMICH_KIOSK_URL;
---

<Layout title="AWS Community Day Jakarta 2026">
    <!-- Hero Section -->
    <ComDayHero client:load kioskUrl={kioskUrl} />

    <!-- Sticky Section Navigation -->
    <ComDaySectionNav client:load />


    <!-- Metrics Stats Section -->
    <MetricsBar client:visible />

    <!-- Speaker CFP Section -->
    <CFPSection client:visible />

    <!-- Ticket Sales Section -->
    <section id="tickets" class="py-20 px-4 bg-background border-b border-border relative">
        <div class="absolute right-0 top-1/4 w-80 h-80 bg-orange-500/5 rounded-full blur-[100px]" />
        <div class="container max-w-4xl mx-auto space-y-12">
            <div class="text-center space-y-4">
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
                    Get Your Tickets
                </h2>
                <div class="w-20 h-1 bg-gradient-to-r from-orange-500 to-pink-500 mx-auto rounded-full" />
                <p class="text-muted-foreground max-w-2xl mx-auto text-base sm:text-lg">
                    Secure your attendance today. Select a ticket tier below to register. Refundable upon check-in.
                </p>
            </div>

            {/* Embedded Pretix Widget */}
            <div class="bg-card/60 backdrop-blur-xl border border-border rounded-3xl p-6 sm:p-8 shadow-2xl relative">
                <PretixWidget
                    client:visible
                    eventUrl="https://gultix.awscommunity.id/AWSUserGroupJakarta/CommunityDay26/"
                    className="w-full"
                />
            </div>

            <div class="text-center text-xs text-muted-foreground/60">
                🔒 Ticket ordering is secure and powered by Pretix.
            </div>
        </div>
    </section>

    <!-- Agenda / Schedule Section -->
    <section id="agenda" class="py-20 px-4 bg-background border-b border-border">
        <div class="container max-w-4xl mx-auto space-y-12">
            <div class="text-center space-y-4">
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
                    Event Schedule
                </h2>
                <div class="w-20 h-1 bg-gradient-to-r from-orange-500 to-pink-500 mx-auto rounded-full" />
                <p class="text-muted-foreground max-w-2xl mx-auto text-base sm:text-lg">
                    An action-packed day of deep dives, technical sessions, panels, and networking tracks.
                </p>
            </div>

            <div class="bg-card/50 border border-border rounded-3xl p-4 sm:p-6 shadow-2xl">
                <AgendaStatus client:visible />
            </div>
        </div>
    </section>

    <!-- Sponsor CTA Section -->
    <SponsorSection client:visible />

    <!-- Sponsors & Partners Showcase Section -->
    <ComDaySponsors client:visible />

    <!-- Calling for Volunteer Section -->
    <VolunteerCallSection client:visible />

    <!-- Organizers & Volunteers Section -->
    {peopleGroups.length > 0 && (
        <section id="team" class="py-20 px-4 bg-background border-b border-border">
            <div class="container max-w-5xl mx-auto space-y-12">
                <div class="text-center space-y-4">
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
                        Organizers & Volunteers
                    </h2>
                    <div class="w-20 h-1 bg-gradient-to-r from-orange-500 to-pink-500 mx-auto rounded-full" />
                    <p class="text-muted-foreground max-w-2xl mx-auto text-base sm:text-lg">
                        The passionate community members working behind the scenes to bring you AWS Community Day 2026.
                    </p>
                </div>

                <div class="bg-card/50 border border-border rounded-3xl p-6 sm:p-8 shadow-2xl">
                    <PeopleList client:visible groups={peopleGroups} />
                </div>
            </div>
        </section>
    )}

    <!-- FAQ Section -->
    <section id="faq" class="py-20 px-4 bg-background">
        <div class="container max-w-4xl mx-auto space-y-12">
            <div class="text-center space-y-4">
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
                    Frequently Asked Questions
                </h2>
                <div class="w-20 h-1 bg-gradient-to-r from-orange-500 to-pink-500 mx-auto rounded-full" />
                <p class="text-muted-foreground max-w-2xl mx-auto text-base sm:text-lg">
                    Need help? Find quick answers for attendees, speakers, and sponsors below.
                </p>
            </div>

            <div class="bg-card/60 border border-border rounded-3xl p-6 sm:p-8 shadow-xl">
                <EventFAQ client:visible faqs={comday26Faqs} />
            </div>
        </div>
    </section>

    <!-- Mobile Sticky Action Bar -->
    <MobileStickyBar client:load />
</Layout>
