---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import FormbricksSDK from "../components/FormbricksSDK.astro";
import { navItems } from "../lib/navigation";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "AWS User Group Jakarta",
	description = "Join the AWS User Group Jakarta community.",
} = Astro.props;

const site = Astro.site?.origin ?? "https://jakarta.awscommunity.id";
const siteNav = navItems.map((item) => ({
	"@type": "SiteNavigationElement",
	name: item.name,
	url: new URL(item.href, site).href,
}));
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<GoogleAnalytics />
		<FormbricksSDK />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@graph": siteNav,
			})}
		/>
	</head>
	<body
		class="min-h-screen bg-background font-sans antialiased flex flex-col"
	>
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
