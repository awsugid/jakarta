---
import Layout from "../layouts/Layout.astro";
import { ScheduleScreenView } from "../components/schedule/ScheduleScreenView";
import { fetchPublicSchedule } from "@/lib/api";
import type { EventScheduleItem } from "@/lib/types";

let initialSchedule: EventScheduleItem[] = [];

try {
	const data = await fetchPublicSchedule("community-day-2026");
	if (Array.isArray(data?.schedule)) {
		initialSchedule = data.schedule;
	}
} catch (e) {
	// Build-time fetch failed or offline; client-side fetch will load from the endpoint directly
}

const isKiosk = Astro.url.searchParams.get("kiosk") === "true";
const initialRoom = Astro.url.searchParams.get("room") || "ALL";
const initialDemoTime = Astro.url.searchParams.get("demoTime") || undefined;
---

<Layout
	title="Live Event Schedule | AWS Community Day Jakarta 2026"
	description="Live full conference schedule, parallel tracks, and real-time active sessions for AWS Community Day Jakarta 2026"
	showHeader={false}
	showFooter={false}
>
	<link rel="preconnect" href="https://api.awscommunity.id" />
	<link rel="preconnect" href="https://avatars.awscommunity.id" />

	<div
		id="schedule-stage-wrapper"
		class="w-screen h-screen overflow-hidden bg-[#0b0d14] m-0 p-0"
	>
		<ScheduleScreenView
			client:load
			initialSchedule={initialSchedule}
			initialKiosk={isKiosk}
			initialRoom={initialRoom}
			initialDemoTime={initialDemoTime}
		/>
	</div>
</Layout>

<style is:global>
	/* Completely hide site header and footer in FULLSCREEN mode or KIOSK mode */
	:fullscreen #site-header,
	:fullscreen header,
	:fullscreen footer,
	html:fullscreen #site-header,
	html:fullscreen header,
	html:fullscreen footer,
	html.fullscreen-mode #site-header,
	html.fullscreen-mode header,
	html.fullscreen-mode footer,
	body.fullscreen-mode #site-header,
	body.fullscreen-mode header,
	body.fullscreen-mode footer,
	html.kiosk-mode #site-header,
	html.kiosk-mode header,
	html.kiosk-mode footer,
	body.kiosk-mode #site-header,
	body.kiosk-mode header,
	body.kiosk-mode footer {
		display: none !important;
	}

	:fullscreen,
	html:fullscreen,
	html.fullscreen-mode,
	html.fullscreen-mode body,
	body.fullscreen-mode,
	html.kiosk-mode,
	html.kiosk-mode body,
	body.kiosk-mode {
		overflow: hidden !important;
		margin: 0 !important;
		padding: 0 !important;
		background-color: #161128 !important;
		width: 100vw !important;
		height: 100vh !important;
	}

	:fullscreen #schedule-stage-wrapper,
	:fullscreen main,
	html:fullscreen main,
	html.fullscreen-mode #schedule-stage-wrapper,
	html.fullscreen-mode main,
	body.fullscreen-mode #schedule-stage-wrapper,
	body.fullscreen-mode main,
	html.kiosk-mode #schedule-stage-wrapper,
	html.kiosk-mode main,
	body.kiosk-mode #schedule-stage-wrapper,
	body.kiosk-mode main {
		width: 100vw !important;
		height: 100vh !important;
		min-height: 100vh !important;
		max-height: 100vh !important;
		overflow: hidden !important;
		margin: 0 !important;
		padding: 0 !important;
		flex: 1 1 100% !important;
	}
</style>
