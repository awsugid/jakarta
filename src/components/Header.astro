---
import { navItems } from "../lib/navigation";
import { MobileNav } from "./MobileNav";
import { HeaderAuth } from "./auth/HeaderAuth";
import { HeaderDesktopNav } from "./HeaderDesktopNav";
import { ComDayMobileSectionNav } from "./community-day/ComDaySectionNav";

const currentPath = Astro.url.pathname;
const isComDayPage = currentPath === "/comday-26" || currentPath === "/comday-26/";
---

<header
    id="site-header"
    class="fixed top-0 left-0 right-0 z-50 w-full border-b border-transparent bg-transparent transition-all duration-300 ease-in-out"
>
    <div
        class="container mx-auto max-w-7xl flex h-16 sm:h-20 items-center justify-between px-4 sm:px-8"
    >
        <div class="flex items-center gap-6 xl:gap-10">
            <a
                href="/"
                class="flex items-center space-x-2 font-bold text-xl tracking-tight transition-transform hover:scale-105 active:scale-95 shrink-0 drop-shadow-[0_1.5px_3px_rgba(0,0,0,0.9)]"
                aria-label="AWS User Group Jakarta"
            >
                <img
                    src="/android-chrome-192x192.png"
                    alt="AWS User Group Jakarta Logo"
                    class="h-9 sm:h-10 w-auto"
                />
            </a>

            {/* Header Desktop Navigation (Morphs between Site Nav and ComDay Section Nav on scroll) */}
            <HeaderDesktopNav client:load currentPath={currentPath} items={navItems} />
        </div>

        <div class="flex items-center gap-2.5 sm:gap-4 shrink-0">
            <HeaderAuth client:load />

            {/* ComDay '26 Mobile Section Hamburger (ONLY renders when on /comday-26 page) */}
            {isComDayPage && <ComDayMobileSectionNav client:load />}

            {/* Main Mobile Navigation */}
            <MobileNav client:load items={navItems} />
        </div>
    </div>
</header>

<script>
    function initHeaderScroll() {
        const header = document.getElementById("site-header");
        if (!header) return;

        const handleScroll = () => {
            if (window.scrollY > 15) {
                header.classList.add(
                    "bg-background/98",
                    "backdrop-blur-md",
                    "border-border/80",
                    "shadow-md",
                    "shadow-black/20"
                );
                header.classList.remove("bg-transparent", "border-transparent");
            } else {
                header.classList.remove(
                    "bg-background/98",
                    "backdrop-blur-md",
                    "border-border/80",
                    "shadow-md",
                    "shadow-black/20"
                );
                header.classList.add("bg-transparent", "border-transparent");
            }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        handleScroll();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHeaderScroll);
    } else {
        initHeaderScroll();
    }
</script>
