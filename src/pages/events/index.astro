---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
    Card,
    CardContent,
    CardFooter,
    CardHeader,
    CardTitle,
    CardDescription,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Calendar, MapPin, ArrowRight } from "lucide-react";
import { ImmichKioskBackground } from "@/components/ImmichKioskBackground";

const events = await getCollection("events");
events.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = "Events - AWS User Group Jakarta";
const description = "Stay updated with our latest meetups, workshops, and conferences.";
const kioskUrl = import.meta.env.PUBLIC_IMMICH_KIOSK_URL;
---

<Layout title={title} description={description}>
    <div class="relative overflow-hidden min-h-[40vh] flex flex-col justify-center pt-28 sm:pt-36 pb-16 md:pb-24 bg-background border-b border-border">

        <ImmichKioskBackground
            client:load
            kioskUrl={kioskUrl}
            randomizeAlbumOnVisit={true}
        />
        <div class="container relative z-10 mx-auto max-w-7xl text-center px-4">
            <h1 class="text-4xl font-extrabold tracking-tight lg:text-5xl mb-4 text-foreground">
                Join Upcoming AWS Events
            </h1>
            <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
                Join us at our community meetups, workshops, and annual AWS Community Day Jakarta.
            </p>
        </div>
    </div>

    <div class="container mx-auto max-w-7xl py-12 px-4 md:px-6">
        {
            events.length > 0 ? (
                <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {events.map((event) => {
                        const isPast = new Date(event.data.date) < new Date();
                        return (
                            <a href={`/events/${event.id}`} class="group block h-full">
                                <Card className="h-full flex flex-col border-border/50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 hover:border-primary/20 bg-card overflow-hidden">
                                    {event.data.image ? (
                                        <div class="aspect-video w-full overflow-hidden relative">
                                            <img
                                                src={event.data.image}
                                                alt={event.data.title}
                                                class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
                                            />
                                            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors" />
                                        </div>
                                    ) : (
                                        <div class="aspect-video w-full bg-muted/30 flex items-center justify-center relative">
                                            <Calendar className="h-8 w-8 text-muted-foreground/30" />
                                        </div>
                                    )}

                                    <CardHeader className="space-y-2">
                                        <div class="flex items-center justify-between mb-2">
                                            <Badge
                                                variant="secondary"
                                                className="bg-primary/10 text-primary hover:bg-primary/20 border-none text-xs"
                                            >
                                                {event.data.type}
                                            </Badge>
                                            {isPast && (
                                                <Badge variant="outline" className="text-xs">
                                                    Past Event
                                                </Badge>
                                            )}
                                        </div>
                                        <CardTitle className="text-xl group-hover:text-primary transition-colors line-clamp-2">
                                            {event.data.title}
                                        </CardTitle>
                                    </CardHeader>

                                    <CardContent className="flex-1 space-y-3">
                                        <div class="space-y-2 text-sm text-muted-foreground">
                                            <div class="flex items-center">
                                                <Calendar className="mr-2 h-4 w-4 text-primary/70" />
                                                {new Date(event.data.date).toLocaleDateString("en-US", {
                                                    year: "numeric",
                                                    month: "long",
                                                    day: "numeric",
                                                })}
                                            </div>
                                            <div class="flex items-center">
                                                <MapPin className="mr-2 h-4 w-4 text-primary/70" />
                                                {event.data.location}
                                            </div>
                                        </div>
                                        <CardDescription className="line-clamp-3">
                                            {event.data.description}
                                        </CardDescription>
                                    </CardContent>

                                    <CardFooter className="pt-4 border-t border-border/50 text-sm">
                                        {!isPast ? (
                                            <div class="flex items-center justify-between w-full">
                                                <span class="font-medium text-primary group-hover:underline underline-offset-4">
                                                    View Details
                                                </span>
                                                <ArrowRight className="h-4 w-4 text-muted-foreground group-hover:text-primary transition-all opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 duration-300" />
                                            </div>
                                        ) : (
                                            <span class="text-muted-foreground">
                                                View Event Summary
                                            </span>
                                        )}
                                    </CardFooter>
                                </Card>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="text-center py-16 px-4 bg-card/40 border border-border rounded-2xl">
                    <p class="text-muted-foreground text-lg">No events published yet. Please check back soon!</p>
                </div>
            )
        }

    </div>
</Layout>
