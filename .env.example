PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
BILLIONMAIL_API_URL=https://mail.awscommunity.id
BILLIONMAIL_API_KEY=your_api_key_here
BILLIONMAIL_SPEAKERS_GROUP_ID=2
BILLIONMAIL_VOLUNTEERS_GROUP_ID=1
# Immich Kiosk URL (e.g., https://kiosk.awscommunity.id). Leave empty to show decorative backgrounds instead of photo slideshow.
PUBLIC_IMMICH_KIOSK_URL=

# Formbricks crash reporting Link Survey URL (e.g., https://app.formbricks.com/s/clxxxxxxxxxxxxxxxxx)
PUBLIC_FORMBRICKS_CRASH_SURVEY_URL=

# Formbricks SDK Connection settings (retrieve from Formbricks Dashboard > Connect Your App)
PUBLIC_FORMBRICKS_WORKSPACE_ID=
PUBLIC_FORMBRICKS_ENVIRONMENT_ID=
PUBLIC_FORMBRICKS_API_HOST=

