---
import Layout from "../layouts/Layout.astro";
import { ProfileEditor } from "../components/profile/ProfileEditor";
---

<Layout
	title="My Profile — AWS User Group Jakarta"
	description="Manage your public AWS User Group Jakarta community profile."
>
	<main class="min-h-[calc(100vh-16rem)] bg-background relative overflow-hidden pt-24 sm:pt-32 pb-16">

		{/* Background glows - Comday 26 style */}
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,rgba(255,153,0,0.12),rgba(255,255,255,0))] pointer-events-none" />
		<div class="absolute top-20 left-1/4 w-96 h-96 bg-purple-900/10 rounded-full blur-[128px] animate-pulse pointer-events-none" />
		<div class="absolute bottom-20 right-1/4 w-96 h-96 bg-orange-500/5 rounded-full blur-[128px] pointer-events-none" />

		{/* Masked Grid Overlay */}
		<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-20 pointer-events-none" />

		<div class="container max-w-4xl mx-auto px-4 md:px-6 relative z-10">
			{/* Page Header */}
			<div class="text-center space-y-4 mb-10 animate-in fade-in slide-in-from-bottom-5 duration-700">
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-orange-500/30 bg-orange-500/10 text-orange-400 text-xs font-semibold">
					<span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-ping" />
					AWS Community Identity
				</div>
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
					Community <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-pink-500 to-purple-500">Profile</span>
				</h1>
				<div class="w-20 h-1 bg-gradient-to-r from-orange-500 via-pink-500 to-purple-500 mx-auto rounded-full" />
				<p class="text-muted-foreground max-w-lg mx-auto text-sm sm:text-base">
					Manage your public builder profile for AWS User Group Jakarta community directories.
				</p>
			</div>

			<ProfileEditor client:load />
		</div>
	</main>
</Layout>
