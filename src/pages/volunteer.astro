---
import Layout from "../layouts/Layout.astro";
import { VolunteerHero } from "../components/volunteer/VolunteerHero";
import { VolunteerRoles } from "../components/volunteer/VolunteerRoles";
import { VolunteerNotify } from "../components/volunteer/VolunteerNotify";
---

<Layout title="Volunteer — AWS User Group Jakarta">
    <VolunteerHero client:load kioskUrl={import.meta.env.PUBLIC_IMMICH_KIOSK_URL} />
    <VolunteerRoles client:visible />
    <VolunteerNotify client:visible />
</Layout>
