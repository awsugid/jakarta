---
import { navItems } from "../lib/navigation";
import { MobileNav } from "./MobileNav";
import { HeaderAuth } from "./auth/HeaderAuth";

const currentPath = Astro.url.pathname;
---

<header
    class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
    <div
        class="container mx-auto max-w-7xl flex h-16 items-center justify-between px-4 sm:px-8"
    >
        <div class="flex items-center gap-8">
            <a
                href="/"
                class="flex items-center space-x-2 font-bold text-xl tracking-tight"
                aria-label="AWS User Group Jakarta"
            >
                <img
                    src="/android-chrome-192x192.png"
                    alt="AWS User Group Jakarta Logo"
                    class="h-10 w-auto"
                />
            </a>
            <nav class="hidden md:flex gap-8 text-sm font-medium">
                {
                    navItems.map((item) => {
                        const isActive = currentPath === item.href || currentPath === `${item.href}/` || (item.href !== '/' && currentPath.startsWith(item.href));
                        return (
                            <a
                                href={item.href}
                                class={`transition-colors hover:text-primary hover:font-semibold ${
                                    isActive
                                        ? "text-primary font-semibold"
                                        : "text-muted-foreground/80"
                                }`}
                            >
                                {item.name}
                            </a>
                        );
                    })
                }
            </nav>
        </div>
        <div class="flex items-center gap-4">
            <HeaderAuth client:load />
            <MobileNav client:load items={navItems} />
        </div>
    </div>
</header>
